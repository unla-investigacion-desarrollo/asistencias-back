# Base de datos MySQL
MYSQLDB_LOCAL_PORT=3307
MYSQLDB_DOCKER_PORT=3306
MYSQLDB_ROOT_PASSWORD=rootpass
MYSQLDB_DATABASE=eventos_db
MYSQLDB_USER=root

# URL de conexion (se arma desde las variables de arriba)
DB_URL=jdbc:mysql://asistencias-fullstack-mysqldb:3306/eventos_db

# Configuracion de correo Gmail (usar contraseña de aplicacion)
EMAIL_SENDER=tu-correo@gmail.com
CODE_EMAIL_SENDER=tu-contraseña-de-aplicacion

# Activacion de envio automatico de certificados
ENVIAR_CERTIFICADOS=true

# URL publica del servidor para los links QR
PUBLIC_QR_LINK_SERVER=http://localhost:8080/eventos/qr/
